# Configuração do Firebase (opcional).
#
# Sem este arquivo o aplicativo abre normalmente em MODO LOCAL (dados no navegador).
# Preenchendo as variáveis abaixo, ele passa a ler e gravar no Firebase.
#
# Como obter: console do Firebase → Configurações do projeto → Seus apps → app Web
# → "Configuração do SDK do Firebase". Copie cada valor para a variável correspondente,
# salve este arquivo como `.env` na raiz e reinicie o `npm run dev`.
#
# Estes valores são públicos (identificam o projeto, não autorizam nada sozinhos).
# Quem protege os dados são as regras em `firestore.rules`. O `.env` fica fora do Git.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Ligue apenas para usar o emulador local (`npx firebase emulators:start`).
VITE_USE_EMULATORS=false
