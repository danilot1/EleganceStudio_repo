# Configuração do Firebase (obrigatória — o app não sobe sem ela).
#
# Como obter: console do Firebase → Configurações do projeto → Seus apps → app Web
# → "Configuração do SDK" → "Configuração do SDK do Firebase". Copie cada valor
# para a variável correspondente abaixo, salve este arquivo como `.env` na raiz
# e reinicie o `npm run dev`.
#
# Estes valores são públicos (identificam o projeto, não autorizam nada sozinhos).
# Quem protege os dados são as regras em `firestore.rules`. Ainda assim, o `.env`
# fica fora do Git: cada pessoa usa o projeto dela.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
