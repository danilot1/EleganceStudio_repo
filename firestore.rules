rules_version = '2';

// Regras do EleganceStudio.
//
// Princípio: negar tudo por padrão. O papel de gestão NÃO vem do navegador — é lido do
// documento users/{uid}, que só o próprio usuário cria (sempre como cliente) e nunca
// promove a si mesmo. A fase 4 do plano acrescenta os testes automatizados destas regras.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function ownsAppointment(data) {
      return signedIn() && data.clientUserId == request.auth.uid;
    }

    match /users/{uid} {
      // A gestão consulta os contatos das clientes; cada pessoa lê o próprio perfil.
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Cadastro sempre nasce como cliente — ninguém se promove a gestão.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'cliente';
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /appointments/{appointmentId} {
      allow read: if isAdmin() || ownsAppointment(resource.data);
      // Agendamento sem conta (convidada) continua permitido, como no protótipo local;
      // com conta, o vínculo precisa ser do próprio usuário.
      allow create: if (isAdmin())
        || (request.resource.data.clientUserId == null)
        || (signedIn() && request.resource.data.clientUserId == request.auth.uid);
      allow update: if isAdmin()
        || (ownsAppointment(resource.data)
          && request.resource.data.clientUserId == resource.data.clientUserId);
      allow delete: if isAdmin();
    }

    // Documento de agenda (um por profissional/dia): é o cadeado da reserva. A
    // transação do cliente lê e grava aqui, por isso a escrita é liberada — as regras
    // não conseguem validar sobreposição de horário. O documento guarda apenas
    // identificador, horários e status, nunca dados pessoais.
    match /agenda/{dayId} {
      allow read: if true;
      allow create, update: if request.resource.data.professionalId is string
        && request.resource.data.dateISO is string
        && request.resource.data.blocks is list;
      allow delete: if isAdmin();
    }

    // Ajustes de duração/preço/visibilidade: catálogo é público para leitura, escrita
    // apenas da gestão.
    match /serviceOverrides/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Pedidos de e-mail (formato da extensão "Trigger Email from Firestore").
    //
    // A cliente precisa criar o pedido do próprio agendamento (inclusive sem conta), por
    // isso a escrita é liberada — mas o formato é validado: destinatário válido, assunto
    // e corpo de texto limitados, e o pedido nasce PENDING. Quem lê o resultado, altera
    // o estado ou apaga é a extensão (Admin SDK) e a gestão.
    match /mail/{mailId} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.to is string
        && request.resource.data.to.size() <= 200
        && request.resource.data.to.matches('.+@.+[.].+')
        && request.resource.data.message.subject is string
        && request.resource.data.message.subject.size() <= 200
        && request.resource.data.message.text is string
        && request.resource.data.message.text.size() <= 4000
        && request.resource.data.delivery.state == 'PENDING';
    }
  }
}
