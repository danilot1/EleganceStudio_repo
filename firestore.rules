rules_version = '2';

// Regras de segurança do EleganceStudio.
//
// Publique no console: Firestore Database → Regras → colar este arquivo → Publicar.
// (ou `firebase deploy --only firestore:rules`, se usar a CLI)
//
// Modelo:
//   users/{uid}        perfil: nome, telefone, papel. Cada pessoa lê só o seu; gestão lê todos.
//   appointments/{id}  atendimento completo. Lê quem é dono ou a gestão. Ninguém mais.
//   agenda/{prof__data} um documento por profissional e dia, com a lista de blocos
//                      ocupados (id do atendimento, horário, duração, status). Sem nome,
//                      telefone ou observação — por isso a leitura é pública: a grade de
//                      horários precisa funcionar antes do login.
//
// O papel de gestão é o campo `role == 'admin'` no documento do usuário. Ele é
// promovido à mão no console (Firestore → users → seu documento → role: "admin"),
// porque só o Admin SDK pode definir custom claims — e ele não faz parte deste app.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    // O Firestore guarda o resultado de get() no mesmo caminho durante a requisição,
    // então esta checagem custa uma leitura por operação, não uma por documento.
    function isAdmin() {
      return signedIn() && get(userDoc(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // Cadastro só cria o próprio perfil e sempre como cliente: ninguém se promove.
      // Telefone é opcional (perfil criado no primeiro login pela gestão não tem telefone).
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'cliente'
        && request.resource.data.name is string
        && request.resource.data.email is string
        && (!('phone' in request.resource.data) || request.resource.data.phone is string);

      // Atualiza nome e telefone; não troca e-mail nem papel.
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email;

      // Promoção a gestão e remoção de perfil são feitas no console.
      allow delete: if false;
    }

    match /appointments/{appointmentId} {
      allow read: if signedIn()
        && (isAdmin() || resource.data.clientUserId == request.auth.uid);

      allow create: if signedIn()
        && (isAdmin() || request.resource.data.clientUserId == request.auth.uid)
        && request.resource.data.keys().hasAll(
             ['clientName', 'serviceId', 'professionalId', 'dateISO',
              'startMin', 'durationMin', 'price', 'status', 'payment', 'origin'])
        && request.resource.data.clientName is string
        && request.resource.data.clientName.size() > 0
        && request.resource.data.clientName.size() <= 120
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.startMin is int
        && request.resource.data.startMin >= 0
        && request.resource.data.durationMin is int
        && request.resource.data.durationMin > 0
        && request.resource.data.dateISO is string;

      // A cliente pode cancelar e reagendar (status volta para "aguardando"),
      // mas não muda preço, serviço, profissional nem duração.
      allow update: if signedIn() && (
        isAdmin() || (
          resource.data.clientUserId == request.auth.uid
          && request.resource.data.clientUserId == resource.data.clientUserId
          && request.resource.data.price == resource.data.price
          && request.resource.data.serviceId == resource.data.serviceId
          && request.resource.data.professionalId == resource.data.professionalId
          && request.resource.data.durationMin == resource.data.durationMin
          && request.resource.data.status in ['cancelado', 'aguardando']
        )
      );

      allow delete: if isAdmin();
    }

    // Um documento por profissional e dia. A escrita é feita pela transação do app;
    // qualquer pessoa conectada pode gravar (não há dado pessoal aqui), o que significa
    // que um cliente mal-intencionado poderia inventar horário ocupado. O risco aceito
    // está registrado em STATUS.md — a correção definitiva é uma Cloud Function.
    match /agenda/{dayId} {
      allow read: if true;

      allow create, update: if signedIn()
        && request.resource.data.professionalId is string
        && request.resource.data.dateISO is string
        && request.resource.data.blocks is list
        && request.resource.data.blocks.size() <= 200;

      allow delete: if isAdmin();
    }
  }
}
