{
  "name": "elegance-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project elegance-rules-test \"vitest run --config vitest.rules.config.ts\"",
    "seed:build": "vite build --config scripts/vite.seed.config.ts",
    "seed:demo": "npm run seed:build && firebase emulators:exec --only auth,firestore --project elegance-demo \"node dist-seed/seed.mjs --demo\"",
    "seed:backfill": "npm run seed:build && node dist-seed/seed.mjs --backfill",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "deploy:app": "npm run build && firebase deploy --only hosting",
    "deploy:all": "npm run build && firebase deploy --only firestore:rules,firestore:indexes,hosting",
    "test:watch": "vitest",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "firebase": "^13.2.0",
    "lucide-react": "^1.57.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.2",
    "jsdom": "^30.1.2",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  }
}
